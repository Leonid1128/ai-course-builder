SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=course_constructor
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0

# openai | llamacpp | llamacpp_python
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_STRUCTURE_TIMEOUT=30
LLM_BLOCK_TIMEOUT=10
LLM_TEMPERATURE=0.3

# llama.cpp server (OpenAI-compatible)
# example (PowerShell): llama-server.exe -m .\model.gguf -ngl 99 -c 16384 --host 0.0.0.0 --port 11434 --embeddings --pooling mean
# LLM_PROVIDER=llamacpp
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=sk-local
# LLM_MODEL=local-model
# LLM_EMBEDDING_MODEL=local-model
# Настроить вручную
# LLM_STRUCTURE_TIMEOUT=30
# LLM_BLOCK_TIMEOUT=10

# in-process GGUF via llama-cpp-python
# LLM_PROVIDER=llamacpp_python
# LLAMA_CPP_MODEL_PATH=./model.gguf
# LLAMA_CPP_N_CTX=8192
# LLAMA_CPP_N_GPU_LAYERS=0
# LLAMA_CPP_N_THREADS=8
# LLAMA_CPP_CHAT_FORMAT=chatml

MAX_PDF_PAGES=100
